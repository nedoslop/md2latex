{\fontsize{14pt}{16.8pt}\selectfont {{ institute }}\par}
{% else %}
\rule{12cm}{0.4pt}\par
{% endif %}
{\fontsize{10pt}{12pt}\selectfont {{ institute_label }}\par}

\vspace{0.6cm}

{% if department | trim != "" %}
{\fontsize{14pt}{16.8pt}\selectfont {{ department }}\par}
{% else %}
\rule{12cm}{0.4pt}\par
{% endif %}
{\fontsize{10pt}{12pt}\selectfont {{ department_label }}\par}
\end{center}

\vspace{1.8cm}

\begin{center}
{\fontsize{14pt}{16.8pt}\selectfont\bfseries {{ doc_kind }}\par}

\vspace{0.8cm}

{\fontsize{14pt}{16.8pt}\selectfont {{ topic }}\par}
\vspace{0.1cm}
