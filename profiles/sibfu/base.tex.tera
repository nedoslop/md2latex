\documentclass[{{- font_size | trim -}},a4paper]{extarticle}

% ========== Geometry ==========
\usepackage[
  left={{- margin_left | trim -}},
  right={{- margin_right | trim -}},
  top={{- margin_top | trim -}},
  bottom={{- margin_bottom | trim -}},
  footskip=10mm
]{geometry}

% ========== Languages and fonts ==========
\usepackage{polyglossia}
\setdefaultlanguage{ {{- language -}} }
\setotherlanguage{ {{- other_language -}} }
\usepackage{fontspec}

\IfFontExistsTF{ {{- main_font | trim -}} }{
  \setmainfont[Ligatures=TeX]{ {{- main_font | trim -}} }
  \newfontfamily\cyrillicfont[Ligatures=TeX]{ {{- main_font | trim -}} }
  \IfFontExistsTF{ {{- mono_font | trim -}} }{
    \setmonofont{ {{- mono_font | trim -}} }
    \newfontfamily\cyrillicfonttt{ {{- mono_font | trim -}} }
  }{
    \setmonofont{DejaVu Sans Mono}
    \newfontfamily\cyrillicfonttt{DejaVu Sans Mono}
  }
}{
  \setmainfont[Ligatures=TeX]{ {{- font_fallback | trim -}} }
  \newfontfamily\cyrillicfont[Ligatures=TeX]{ {{- font_fallback | trim -}} }
  \setmonofont{TeX Gyre Cursor}
  \newfontfamily\cyrillicfonttt{TeX Gyre Cursor}
}

% ========== Line breaking ==========
\usepackage[protrusion=true,expansion=false]{microtype}
{% if lb_sloppy %}\sloppy{% endif %}
\emergencystretch={{ lb_emergencystretch }}
\hyphenpenalty={{ lb_hyphen_penalty }}
\exhyphenpenalty={{ lb_exhyphen_penalty }}
\tolerance={{ lb_tolerance }}
\hbadness={{ lb_hbadness }}

% ========== Spacing and paragraphs ==========
\usepackage{setspace}
{% if line_spacing == "double" %}\doublespacing
{% elif line_spacing == "onehalf" %}\onehalfspacing
{% else %}\singlespacing
{% endif %}
\usepackage{indentfirst}
\setlength{\parindent}{ {{- paragraph_indent | trim -}} }
\setlength{\parskip}{0pt}

% ========== Graphics, tables, formulas ==========
\usepackage{graphicx}
\usepackage{float}
\usepackage{array}
\usepackage{tabularx}
\usepackage{xltabular}
\usepackage{multirow}
\usepackage{hhline}
\renewcommand{\multirowsetup}{\centering}
% Column types honouring GFM table alignment.
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcolumntype{Y}{>{\centering\arraybackslash}X}  % legacy alias for C
\renewcommand{\arraystretch}{1.2}
\setlength{\doublerulesep}{1\arrayrulewidth}
\usepackage{amsmath,amssymb}
\usepackage{caption}
\usepackage{xcolor}
\usepackage[normalem]{ulem}   % \sout
% TODO: is this right???
\AtBeginDocument{
  \setlength{\abovedisplayskip}{0pt}
  \setlength{\belowdisplayskip}{10pt}
  \setlength{\abovedisplayshortskip}{0pt}
  \setlength{\belowdisplayshortskip}{10pt}
}
\setlength{\intextsep}{0.7\baselineskip}
\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{0pt}

% ========== Captions ==========
\DeclareCaptionLabelSeparator{stu}{~\textendash~}
\captionsetup[figure]{
  labelsep=stu,
  justification=centering,
  position={% if figure_caption_below %}bottom{% else %}top{% endif %},
  singlelinecheck=false,
  font={normalsize},
  indention=0pt,
  belowskip=-8pt
}
\captionsetup[table]{
  labelsep=stu,
  justification=raggedright,
  position={% if table_caption_above %}top{% else %}bottom{% endif %},
  singlelinecheck=false,
  font={normalsize},
  skip=4pt,
  indention=0pt
}
\captionsetup[longtable]{
  labelsep=stu,
  justification=raggedright,
  position=top,
  singlelinecheck=false,
  font={normalsize},
  skip=4pt,
  indention=0pt
}

% ========== Code highlighting ==========
{% if code_enabled %}
\captionsetup[lstlisting]{
  labelsep=stu,
  justification=raggedright,
  position=top,
  singlelinecheck=false,
  font={normalsize},
  skip=4pt,
  indention=0pt
}
{% if code_engine == "minted" %}
\usepackage{minted}
\setminted{
  fontsize={{ code_font_size | trim }},
  {% if code_line_numbers %}linenos=true,{% else %}linenos=false,{% endif %}
  {% if code_frame %}frame=single,{% else %}frame=none,{% endif %}
  breaklines=true,
  tabsize=2,
  autogobble=true,
}
{% else %}
\usepackage{listings}
\lstset{
  aboveskip=4pt,
  belowskip=6pt,
  basicstyle=\linespread{1.0}\ttfamily\fontsize{ {{- code_font_size | trim -}} }{ {{- code_baseline | trim -}} }\selectfont,
  extendedchars=false,
  inputencoding=utf8,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  showlines=true,
  showstringspaces=false,
  upquote=true,
  tabsize=2,
  {% if code_frame %}frame=single,{% else %}frame=none,{% endif %}
  {% if code_line_numbers %}numbers=left,{% else %}numbers=none,{% endif %}
  numberstyle=\tiny,
  numbersep=5pt,
  keywordstyle=\bfseries\color[rgb]{0.10,0.10,0.55},
  commentstyle=\itshape\color[rgb]{0.10,0.50,0.10},
  stringstyle=\color[rgb]{0.65,0.10,0.10},
}

% Custom language definitions for listings (not built in).
\lstdefinelanguage{Rust}{
  keywords={as,break,const,continue,crate,else,enum,extern,false,fn,for,
            if,impl,in,let,loop,match,mod,move,mut,pub,ref,return,self,
            Self,static,struct,super,trait,true,type,unsafe,use,where,
            while,async,await,dyn},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]',
}
\lstdefinelanguage{Go}{
  keywords={break,case,chan,const,continue,default,defer,else,
            fallthrough,for,func,go,goto,if,import,interface,map,
            package,range,return,select,struct,switch,type,var},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]`,
}
\lstdefinelanguage{JavaScript}{
  keywords={break,case,catch,const,continue,debugger,default,delete,do,
            else,export,extends,finally,for,function,if,import,in,
            instanceof,let,new,return,super,switch,this,throw,try,
            typeof,var,void,while,with,yield,async,await,of,static,
            get,set,true,false,null,undefined},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]',
  morestring=[b]`,
}
\lstdefinelanguage{PlantUML}{
  morekeywords={actor,participant,boundary,control,entity,database,collections,
                queue,class,interface,enum,abstract,struct,annotation,package,
                namespace,node,folder,frame,cloud,rectangle,component,usecase,
                state,object,as,note,left,right,of,on,top,bottom,over,activate,
                deactivate,destroy,create,return,alt,else,opt,loop,par,break,
                critical,group,end,title,header,footer,legend,skinparam,
                autonumber,newpage,box,hide,show,start,stop,if,then,endif,
                while,endwhile,repeat,backward,fork,again},
  alsoletter={@},
  morekeywords=[2]{@startuml,@enduml,@startmindmap,@endmindmap,@startwbs,@endwbs,
                   @startgantt,@endgantt,@startjson,@endjson,@startyaml,@endyaml},
  keywordstyle=[2]\bfseries\color[rgb]{0.50,0.10,0.50},
  sensitive=true,
  morecomment=[l]{'},
  morecomment=[s]{/'}{'/},
  morestring=[b]",
}
{% endif %}
{% endif %}

% ========== Lists: level-dependent indentation ==========
\usepackage{enumitem}

\makeatletter
\setlist[itemize]{
  label={{ itemize_label }},
  align=left,
  labelindent=\dimexpr{{ paragraph_indent | trim }} + 1pt + 3.5mm*(\@listdepth-1)\relax,
  leftmargin=0pt,
  itemindent=*,
  labelsep=0.5em,
  topsep=0pt, partopsep=0pt, parsep=0pt, itemsep=0pt
}

\setlist[enumerate]{
  label={{ enumerate_label }},
  labelindent=\dimexpr{{ paragraph_indent | trim }} + 3.5mm*(\@listdepth-1)\relax,
  leftmargin=0pt,
  itemindent=*,
  labelsep=0.5em,
  topsep=0pt, partopsep=0pt, parsep=0pt, itemsep=0pt
}
\makeatother

% Allow hyphenation inside compound words (e.g. LaTeX-document).
\lccode`\-=`\-
\defaulthyphenchar=127

% Bibliography list (1., 2., 3.).
\newlist{stubiblist}{enumerate}{1}
\setlist[stubiblist]{
  label={{ bibliography_label }},
  wide={{ paragraph_indent | trim }},
  leftmargin=0pt,
  labelsep=0.5em,
  topsep=0pt, partopsep=0pt, parsep=0pt, itemsep=0pt
}

% ========== Counters ==========
{% if numbering == "within_section" %}
\usepackage{chngcntr}
\counterwithin{figure}{section}
\counterwithin{table}{section}
\counterwithin{equation}{section}
{% if code_enabled and code_engine != "minted" %}
\AtBeginDocument{\counterwithin{lstlisting}{section}}
{% endif %}
{% endif %}

% ========== Page numbering ==========
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% ========== Section headings ==========
\usepackage[indentafter]{titlesec}

\titleformat{\section}[block]
  {\normalfont{% if section_bold %}\bfseries{% endif %}{% if section_align == "center" %}\centering{% else %}\raggedright{% endif %}\hyphenpenalty=10000\exhyphenpenalty=10000}
  { {{- "" -}}{% if section_align != "center" %}\hspace*{ {{- paragraph_indent | trim -}} }{% endif %}\thesection}
  {0.35em}
  {% if section_uppercase %}{\MakeUppercase}{% else %}{}{% endif %}
\titlespacing*{\section}{0pt}{ {{- section_before_skip | trim -}} }{ {{- section_after_skip | trim -}} }

\titleformat{\subsection}[block]
  {\normalfont\bfseries\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000}
  {\hspace*{ {{- paragraph_indent | trim -}} }\thesubsection}
  {0.35em}
  {}
\titlespacing*{\subsection}{0pt}{ {{- subsection_before_skip | trim -}} }{ {{- subsection_after_skip | trim -}} }

\titleformat{\subsubsection}[block]
  {\normalfont\bfseries\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000}
  {\hspace*{ {{- paragraph_indent | trim -}} }\thesubsubsection}
  {0.35em}
  {}
\titlespacing*{\subsubsection}{0pt}{ {{- subsection_before_skip | trim -}} }{ {{- subsection_after_skip | trim -}} }

% ========== Table of contents ==========
\usepackage{tocloft}

\renewcommand{\cfttoctitlefont}{\hspace*{\fill}\normalfont\bfseries}
\renewcommand{\cftaftertoctitle}{\hspace*{\fill}}
\setlength{\cftbeforetoctitleskip}{0pt}
\setlength{\cftaftertoctitleskip}{\baselineskip}

\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftsubsubsecleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftdotsep}{1.5}

\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsubsecfont}{\normalfont}
\renewcommand{\cftsubsecpagefont}{\normalfont}
\renewcommand{\cftsubsubsecfont}{\normalfont}
\renewcommand{\cftsubsubsecpagefont}{\normalfont}

\setlength{\cftbeforesecskip}{2pt}
\setlength{\cftbeforesubsecskip}{2pt}
\setlength{\cftbeforesubsubsecskip}{2pt}

\setlength{\cftsecindent}{0em}
\setlength{\cftsubsecindent}{1em}
\setlength{\cftsubsubsecindent}{2em}

\cftsetpnumwidth{1.8em}
\cftsetrmarg{2.5em}

% ========== Footnotes (СТУ 7.5-07) ==========
\usepackage[bottom]{footmisc}

{% raw %}
\renewcommand{\footnoterule}{%
  \kern -3pt
  \hrule width 5cm height 0.4pt
  \kern 2.6pt
}
{% endraw %}

\makeatletter
\renewcommand{\@makefntext}[1]{
  \fontsize{10pt}{12pt}\selectfont%
  \linespread{1.0}\selectfont%
  \textsuperscript{\@thefnmark}\,#1%
}
\makeatother

% ========== Links ==========
{% if links_colored %}
\usepackage[breaklinks=true,linktoc=all]{hyperref}
{% else %}
\usepackage[breaklinks=true,hidelinks,linktoc=all]{hyperref}
{% endif %}
\hypersetup{
  colorlinks={% if links_colored %}true{% else %}false{% endif %},
  linkcolor={ {{- links_link_color | trim -}} },
  citecolor={ {{- links_cite_color | trim -}} },
  urlcolor={ {{- links_url_color | trim -}} },
  filecolor={ {{- links_url_color | trim -}} },
  linktoc=all,
  pdfborder={% if links_boxed %}0 0 1{% else %}0 0 0{% endif %},
  pdftitle={ {{- topic | trim -}} },
  pdfauthor={ {{- student_author | trim -}} },
  pdfpagelayout={SinglePage}
}
\urlstyle{same}
\usepackage{xurl}

% ========== Clickable dots in ToC ==========
{% if toc_clickable_dots %}
{% raw %}
\makeatletter
\gdef\@toclinktarget{}
\let\old@contentsline\contentsline
\renewcommand{\contentsline}[4]{%
  \gdef\@toclinktarget{#4}%
  \old@contentsline{#1}{#2}{#3}{#4}%
  \global\let\@toclinktarget\@empty
}
\renewcommand{\cftdotfill}[1]{%
  \def\@tempa{#1}%
  \def\@tempb{\cftnodots}%
  \ifx\@tempa\@tempb
    \hfill
  \else
    \ifx\@toclinktarget\@empty
      \leaders\hbox{$\m@th\mkern #1 mu\hbox{\cftdot}\mkern #1 mu$}\hfill
    \else
      \leaders\hbox{$\m@th\mkern #1 mu\hbox{\hyperlink{\@toclinktarget}{\cftdot}}\mkern #1 mu$}\hfill
    \fi
  \fi
}
\makeatother
{% endraw %}
{% endif %}

{% if use_biblatex %}
\usepackage[style=gost-numeric,sorting=none]{biblatex}
\addbibresource{ {{- bib_file | trim -}} }
{% endif %}

% ========== Localized names ==========
\addto\captions{{ language }}{
  \renewcommand{\contentsname}{ {{- labels.contents_name | trim -}} }
  \renewcommand{\refname}{ {{- labels.bibliography_name | trim -}} }
  \renewcommand{\figurename}{ {{- labels.figure_name | trim -}} }
  \renewcommand{\tablename}{ {{- labels.table_name | trim -}} }
  \renewcommand{\lstlistingname}{ {{- labels.listing_name | trim -}} }
}

% ========== "Continued / End of table" support ==========
% Defaults below are neutral; they are overridden by \ltSetLabels,
% which markdown.rs emits before every breakable table.
\usepackage{refcount}
\usepackage{etoolbox}
{% raw %}
\makeatletter
\newcounter{ltid}
\gdef\lt@cont@label{Continued table}
\gdef\lt@end@label{End of table}
\def\ltSetLabels#1#2{\gdef\lt@cont@label{#1}\gdef\lt@end@label{#2}}
\newcommand{\LT@print@head}{%
  \hbox to \textwidth{%
    \normalfont\normalsize
    \ifnum\getpagerefnumber{ltend:\arabic{ltid}}=\value{page}%
      \lt@end@label~\thetable%
    \else
      \lt@cont@label~\thetable%
    \fi
    \hfil
  }%
  \nobreak\vskip 4pt\nobreak
  \copy\LT@head
}
\patchcmd{\LT@output}{\copy\LT@head}{\LT@print@head}{}{}
\makeatother
{% endraw %}

\begin{document}

{{ title_page }}

\setcounter{page}{2}
\clearpage
{% raw %}
{
  \renewcommand{\numberline}[1]{#1\ }
  \tableofcontents
}
{% endraw %}
\clearpage

{{ body }}

{% if use_biblatex %}
\clearpage
\phantomsection
\addcontentsline{toc}{section}{ {{- labels.bibliography_name | trim -}} }
{\centering\setlength{\parindent}{0pt}\textbf{ {{- labels.bibliography_name | trim -}} }\par}
\vspace{\baselineskip}
\printbibliography[heading=none]
{% endif %}

\end{document}
